  "private": true,
  "engines": {
    "node": ">=20.9.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "predev": "node scripts/prepare-ocr-runtime.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/prepare-ocr-runtime.mjs",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
