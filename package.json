    "test:member-upload": "tsx --test tests/member-directory-upload.test.ts tests/member-directory-management.test.ts",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "latest",
    "clsx": "latest",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "next": "latest",
    "onnxruntime-web-ocr": "npm:onnxruntime-web@1.24.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "xlsx": "^0.18.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.2",
    "tsx": "latest",
    "typescript": "latest"
  }
